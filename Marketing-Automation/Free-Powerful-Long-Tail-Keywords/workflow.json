      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of items) {\n  const raw = item.json.data || \"\";\n  let arr;\n  try {\n    arr = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n  } catch (e) {\n    throw new Error(\"Data is not valid JSON\");\n  }\n\n  const suggestions = Array.isArray(arr?.[1]) ? arr[1] : [];\n\n  for (const kw of suggestions) {\n    out.push({ json: { keyword: kw } });\n  }\n}\n\nreturn out;\n\n\n"
      },
