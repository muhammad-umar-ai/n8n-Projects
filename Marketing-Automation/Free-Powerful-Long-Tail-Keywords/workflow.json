        "messages": {
          "values": [
            {
              "content": "=Act as an SEO strategist.\nGenerate 10 short SEO seed keywords for the niche \"{{ $json.chatInput }}\".\n\nRules:\n\nEach keyword must be 2–3 words only.\n\nFocus on topics that can expand into profitable long-tail search terms.\n\nAvoid any explanations, extra text, or formatting.\n\nEach keyword must be returned as a separate JSON object on its own line.\n\nThe output must be valid JSON Lines (JSONL) format, like this:\n\n{\"keyword\": \"travel tips\"}\n{\"keyword\": \"cheap flights\"}\n{\"keyword\": \"travel insurance\"}\n\nDo not wrap them in an array.\nDo not include brackets, commas, or quotes around the full output.\nOnly 10 JSON objects, one per line."
            }
          ]
        },
        "options": {}
      },
