      "name": "Senior SEO seed word finder"
    },
    {
      "parameters": {
        "jsCode": "// Get the raw text from the AI output\nconst raw = $json.content?.parts?.[0]?.text || \"\";\n\n// Split by newline and clean up each line\nconst lines = raw\n  .split(\"\\n\")\n  .map(l => l.trim())\n  .filter(l => l.startsWith(\"{\") && l.endsWith(\"}\"));\n\n// Parse each line as JSON object\nreturn lines.map(l => ({ json: JSON.parse(l) }));\n"
      },
